# AjoChain Environment Variables
# Copy to .env and set your deployment key

# Private key of deployer (with OKB for gas on X Layer)
PRIVATE_KEY=your_private_key_here

# X Layer RPC Endpoints
XLAYER_TESTNET_RPC=https://testrpc.xlayer.tech
XLAYER_MAINNET_RPC=https://rpc.xlayer.tech

# Optional OKLink API Key for verification
OKLINK_API_KEY=
